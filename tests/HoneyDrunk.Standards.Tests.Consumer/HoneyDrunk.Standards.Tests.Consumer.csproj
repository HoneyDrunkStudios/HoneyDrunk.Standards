<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(ConsumerTargetFramework)' == ''">net11.0</TargetFramework>
    <TargetFramework Condition="'$(ConsumerTargetFramework)' != ''">$(ConsumerTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);SA0001;SA1600;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\samples\Consumer.Sample\Consumer.Sample.csproj" PrivateAssets="all" />
    <PackageReference Include="HoneyDrunk.Standards.Tests" Version="0.4.4" PrivateAssets="all" />
  </ItemGroup>

</Project>
