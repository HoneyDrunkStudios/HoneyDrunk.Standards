<?xml version="1.0" encoding="utf-8"?>
<!--
  ADR-0047 Tier 2 coverage template: 60% line / 55% branch, warn-only posture.
  This template emits coverage without a failing threshold because coverlet's
  threshold settings are build-breaking; CI owns warning emission and the
  30-day advisory grace-period behavior.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[*.Tests.*]*,[*.Generated]*,[*]*.Migrations.*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/Migrations/**/*.cs,**/*.g.cs,**/*.g.i.cs,**/*.Designer.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
