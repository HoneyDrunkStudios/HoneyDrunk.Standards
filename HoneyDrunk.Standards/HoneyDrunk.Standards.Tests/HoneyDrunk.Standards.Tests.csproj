<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>HoneyDrunk.Standards.Tests</PackageId>
    <Version>0.2.9</Version>
    <Authors>HoneyDrunk Studios</Authors>
    <Description>ADR-0047 test-stack package for HoneyDrunk test projects: xUnit v2, NSubstitute, AwesomeAssertions, coverlet, and HoneyDrunk.Standards.</Description>
    <PackageReleaseNotes>v0.2.9: Fix transitive compile/runtime dependency flow for ADR-0047 test-stack consumers.</PackageReleaseNotes>
    <PackageTags>standards;tests;xunit;nsubstitute;awesomeassertions;coverlet;adr-0047</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/HoneyDrunkStudios/HoneyDrunk.Standards</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128;NU5100;CA1016</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="buildTransitive\**\*" Pack="true" PackagePath="buildTransitive\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Consumer.Sample\Consumer.Sample.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\HoneyDrunk.Standards\HoneyDrunk.Standards.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" PrivateAssets="none" />
    <PackageReference Include="xunit" Version="2.9.3" PrivateAssets="none" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="none" />
    <PackageReference Include="NSubstitute" Version="5.3.0" PrivateAssets="none" />
    <PackageReference Include="AwesomeAssertions" Version="9.4.0" PrivateAssets="none" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" PrivateAssets="none" />
  </ItemGroup>

</Project>
