<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[4.3.0]" />
    <ProjectReference Include="../src/HoneyDrunk.Standards.Unity.Analyzers.csproj" />
    <None Include="../src/bin/$(Configuration)/netstandard2.0/Microsoft.Unity.Analyzers.dll" Link="Microsoft.Unity.Analyzers.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../profile/HoneyDrunk.Unity.ruleset" Link="HoneyDrunk.Unity.ruleset" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
